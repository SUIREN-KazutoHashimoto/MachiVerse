<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../docs/protocols/schema/common.proto" GrpcServices="Both" Link="Protocol/Schema/common.proto" />
    <Protobuf Include="../../docs/protocols/schema/auth.proto" GrpcServices="None" Link="Protocol/Schema/auth.proto" />
    <Protobuf Include="../../docs/protocols/schema/payloads.proto" GrpcServices="None" Link="Protocol/Schema/payloads.proto" />
  </ItemGroup>
</Project>
