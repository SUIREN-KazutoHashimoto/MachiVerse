@page "/"
@implements IAsyncDisposable
@inject GeneralViewConfig Config
@inject GatewayProtocolClient Gateway
@inject ConfirmedWorldStore ConfirmedStore
@inject ThreeRendererInterop Renderer

<PageTitle>MachiVerse</PageTitle>

<main class="shell">
    <h1>MachiVerse General View</h1>
    <p>Confirmed-state presentation / Three.js renderer foundation.</p>
    <dl>
        <dt>Lifecycle</dt>
        <dd>@Gateway.State</dd>
        <dt>Target FPS</dt>
        <dd>@Config.TargetFps</dd>
        <dt>Renderer</dt>
        <dd>@(_rendererStatus?.Initialized == true ? $"Three.js r{_rendererStatus.ThreeRevision} / {_rendererStatus.BackendMode}" : "initializing")</dd>
        @if (_rendererStatus?.BasisStep is { } basisStep)
        {
            <dt>Rendered confirmed basis</dt>
            <dd>@basisStep</dd>
        }
        @if (_rendererError is not null)
        {
            <dt>Renderer error</dt>
            <dd>@_rendererError</dd>
        }
    </dl>
    <canvas id="machiverse-scene" aria-label="MachiVerse world presentation surface"></canvas>
</main>

@code {
    private RendererStatus? _rendererStatus;
    private string? _rendererError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _rendererStatus = await Renderer.InitializeHostAsync(
                "machiverse-scene",
                Config.MaxPixelRatio);

            if (ConfirmedStore.Current is { } confirmed)
            {
                await Renderer.ApplySceneProjectionAsync(SceneProjectionModel.FromConfirmed(confirmed));
                _rendererStatus = await Renderer.GetStatusAsync();
            }
        }
        catch (Exception ex)
        {
            _rendererError = ex.Message;
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync() => await Renderer.DisposeAsync();
}
