@page "/"
@inject AdminViewConfig Config
@inject AdminGatewayProtocolClient Gateway

<PageTitle>MachiVerse Administration</PageTitle>

<main class="shell">
    <h1>MachiVerse Administration View</h1>
    <p>ADMIN-01 protocol client foundation.</p>
    <dl>
        <dt>Security domain</dt>
        <dd>@AdminSecurityDomain.DomainId</dd>
        <dt>Lifecycle</dt>
        <dd>@Gateway.State</dd>
        <dt>Dashboard refresh</dt>
        <dd>@Config.DashboardRefreshMs ms</dd>
    </dl>
</main>
